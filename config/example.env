# Example environment variables (DO NOT put secrets here in source control)

# AWS
S3_PREDICTIONS_BUCKET=
S3_PREDICTIONS_PREFIX=predictions/
S3_INGEST_BUCKET=

# DataRobot
DATAROBOT_API_KEY=
DATAROBOT_URL=https://app.datarobot.com/api/v2
DATAROBOT_DEPLOYMENT_ID=

# Databricks (if agent triggers Databricks jobs)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Agent
AGENT_POLL_SECONDS=300
AGENT_SAMPLE_INPUT_KEY=sample/input.json
AGENT_SAMPLE_OUTPUT_KEY=sample/predictions.json
